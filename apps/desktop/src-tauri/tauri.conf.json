{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiobook Generator",
  "version": "0.1.0",
  "identifier": "local.audiobook.generator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audiobook Generator",
        "width": 1180,
        "height": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
